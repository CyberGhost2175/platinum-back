NODE_ENV=development
PORT=8080
API_PREFIX=api

# PostgreSQL (docker-compose: user developer / password 123 / db platinum / port 5432)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=developer
DB_PASSWORD=123
DB_DATABASE=platinum
DB_SYNCHRONIZE=false
DB_LOGGING=false
DB_SSL=false

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Sessions (stored in Redis). SESSION_SECRET must be at least 16 characters.
SESSION_SECRET=replace-with-long-random-string
SESSION_NAME=platinum.sid
SESSION_TTL_SECONDS=86400

# CORS — comma-separated origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Rate limiting
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# JWT secrets must be at least 16 characters
JWT_ACCESS_SECRET=replace-with-long-random-string
JWT_REFRESH_SECRET=replace-with-another-long-random-string
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
PASSWORD_RESET_TTL_SECONDS=900
TOTP_ISSUER=Platinum CRM
# 2FA / TOTP for admin and store_manager. Off for now.
AUTH_2FA_ENABLED=false

# Warehouse / catalog
STALE_ITEM_DAYS=180
LOW_STOCK_THRESHOLD=2
CATALOG_SEARCH_DRIVER=postgres
# ELASTICSEARCH_NODE=http://localhost:9200
# DEFAULT_WAREHOUSE_LOCATION_ID=

# Analytics (optional read replica; omit ANALYTICS_DB_HOST to use primary)
ANALYTICS_CACHE_TTL_SECONDS=90
ANALYTICS_MV_STALE_SECONDS=60
# ANALYTICS_DB_HOST=
# ANALYTICS_DB_PORT=5432
# ANALYTICS_DB_USERNAME=
# ANALYTICS_DB_PASSWORD=
# ANALYTICS_DB_DATABASE=
