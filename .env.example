# Скопируй в .env на сервере и заполни секреты.
# Docker Compose читает этот файл целиком (app, postgres, redis).
# openssl rand -hex 32  — для SESSION_SECRET и JWT_*

NODE_ENV=production
PORT=8080
API_PREFIX=api

# В Docker: имена сервисов из docker-compose.yml (не localhost)
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=platinum
DB_PASSWORD=replace-with-strong-db-password
DB_DATABASE=platinum
DB_SYNCHRONIZE=false
DB_LOGGING=false
DB_SSL=false

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

SESSION_SECRET=replace-with-long-random-string
SESSION_NAME=platinum.sid
SESSION_TTL_SECONDS=86400

# URL фронта, через запятую. Без слэша в конце.
CORS_ORIGINS=https://your-frontend.example

THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

JWT_ACCESS_SECRET=replace-with-long-random-string
JWT_REFRESH_SECRET=replace-with-another-long-random-string
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
PASSWORD_RESET_TTL_SECONDS=900
TOTP_ISSUER=Platinum CRM
AUTH_2FA_ENABLED=false

STALE_ITEM_DAYS=180
LOW_STOCK_THRESHOLD=2
CATALOG_SEARCH_DRIVER=postgres
ANALYTICS_CACHE_TTL_SECONDS=90
ANALYTICS_MV_STALE_SECONDS=60

# Локально без Docker (npm run start:dev) поменяй только:
# NODE_ENV=development
# DB_HOST=localhost
# REDIS_HOST=localhost
# CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# DB_USERNAME=developer
# DB_PASSWORD=123
